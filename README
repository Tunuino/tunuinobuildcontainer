# This makes it simpler to compile tunuino firmware by shoving the build environment into a container with ubuntu and all of the latest software bits required


# build and run the container, it should have all the bits needed for compiling

./build_container.sh 
./run_container.sh

# check out the code into repo directory

cd /tunuino

git clone https://github.com/Tunuino/tunuino.git

cd tunuino

git submodule update --init --recursive

cd firmware

make BOARD=stm32f429



root@tunuino_build:/tunuino/tunuino/firmware# make BOARD=stm32f429

Building Tunuino firmware for STM32F429

.
.
.
.



Output: platform/stm32f429/build/tunuino.elf
Output: platform/stm32f429/build/tunuino.bin

Done
root@tunuino_build:/tunuino/tunuino/firmware#


# ---------------------
# firware is here

ls -la /tunuino/tunuino/firmware/platform/stm32f429/build


root@tunuino_build:/tunuino/tunuino/firmware/platform/stm32f429/build# ls -la /tunuino/tunuino/firmware/platform/stm32f429/build

# Example file names; actual sizes and timestamps depend on the build:
tunuino.bin
tunuino.elf

## exit out of the container, it will get removed on exit, but the repo directory is external and ./run_container.sh will get back to spot where compile can happen

